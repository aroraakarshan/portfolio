---
interface ServiceItem {
  title: string;
  description: string;
}

const { services, bookingLink } = Astro.props as {
  services: ServiceItem[];
  bookingLink: string;
};
---

<div class="bk-widget" id="bk-widget">
  <!-- Service selector tabs -->
  <div class="bk-tabs" id="bk-tabs">
    {
      services.map((svc: { title: string; description: string }, i: number) => (
        <button
          class={`bk-tab ${i === 0 ? 'bk-tab--active' : ''}`}
          data-index={i}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          <span class="bk-tab-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="bk-tab-title">{svc.title}</span>
        </button>
      ))
    }
  </div>

  <!-- Selected service description -->
  <p class="bk-service-desc" id="bk-service-desc">{services[0]?.description}</p>

  <!-- Month label -->
  <p class="bk-month-label" id="bk-month-label"></p>

  <!-- Date bar -->
  <div class="bk-date-scroll">
    <div class="bk-date-bar" id="bk-date-bar" role="listbox" aria-label="Available dates"></div>
  </div>

  <!-- Time slots -->
  <div class="bk-time-section" id="bk-time-slots"></div>

  <!-- Booking summary + CTA -->
  <div id="bk-summary"></div>
</div>

<script>
  import { initBookingWidget } from '../scripts/booking';

  const link = bookingLink;
  const serviceItems = services;

  // Init after DOM ready
  const init = () => {
    initBookingWidget(link);

    // Month label
    const now = new Date();
    const monthLabel = document.getElementById('bk-month-label');
    if (monthLabel) {
      monthLabel.textContent = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    }

    // Tab switching
    const tabs = document.querySelectorAll('.bk-tab');
    const descEl = document.getElementById('bk-service-desc');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('bk-tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('bk-tab--active');
        tab.setAttribute('aria-selected', 'true');
        const idx = parseInt(tab.getAttribute('data-index') || '0');
        if (descEl && serviceItems[idx]) {
          descEl.textContent = serviceItems[idx].description;
        }
      });
    });
  };

  // Run on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
