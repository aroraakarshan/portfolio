---
interface Props {
  tag?: string;
}
const { tag = 'general' } = Astro.props;
---
<div class="nl-card" data-reveal>
  <div class="nl-eyebrow">Newsletter - Free - No spam</div>
  <h3 class="nl-title">Get new EMIR lessons by email</h3>
  <p class="nl-sub">One short email when a new lesson, tool or video goes live. Unsubscribe any time.</p>

  <div class="nl-body">
    <form
      class="nl-form"
      action="https://buttondown.com/api/emails/embed-subscribe/akarshanarora"
      method="post"
      target="_blank"
      data-tag={tag}
    >
      <input type="hidden" name="tag" value={tag} />
      <input type="hidden" name="embed" value="1" />
      <label class="nl-visually-hidden" for="nl-email">Email address</label>
      <input id="nl-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
      <button type="submit">Subscribe</button>
    </form>
    <div class="nl-success" role="status" hidden>
      Almost there - check your inbox for a confirmation link.
    </div>
  </div>
  <div class="nl-error" role="alert" aria-live="polite"></div>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('.nl-form').forEach((form) => {
    const card = form.closest('.nl-card') as HTMLElement;
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    const button = form.querySelector('button') as HTMLButtonElement;
    const success = card.querySelector('.nl-success') as HTMLElement;
    const error = card.querySelector('.nl-error') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      input.disabled = true;
      button.disabled = true;
      button.textContent = 'Subscribing...';
      error.textContent = '';

      try {
        const fd = new FormData();
        fd.append('email', email);
        fd.append('tag', form.dataset.tag || 'general');
        fd.append('embed', '1');
        // no-cors: the response is opaque, so a POST that does not throw counts as success
        await fetch(form.action, { method: 'POST', body: fd, mode: 'no-cors' });
        form.style.visibility = 'hidden';
        success.hidden = false;
        input.value = '';
      } catch {
        error.textContent = 'Something went wrong. Please try again.';
        input.disabled = false;
        button.disabled = false;
        button.textContent = 'Subscribe';
      }
    });
  });
</script>

<style>
  .nl-card {
    margin-top: 3.5rem;
    max-width: 640px;
    background: var(--bg-card);
    border: 1px solid var(--hairline);
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    padding: 1.75rem;
  }
  .nl-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .nl-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 0.4rem;
  }
  .nl-sub {
    font-size: 0.92rem;
    color: var(--text-dim);
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }
  .nl-body {
    display: grid;
  }
  .nl-form,
  .nl-success {
    grid-area: 1 / 1;
  }
  .nl-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .nl-form input[type='email'] {
    flex: 1;
    min-width: 200px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    font-size: 0.95rem;
  }
  .nl-form input[type='email']::placeholder {
    color: var(--text-muted);
  }
  .nl-form input[type='email']:focus {
    outline: none;
    border-color: var(--accent);
  }
  .nl-form button {
    padding: 0.75rem 1.4rem;
    background: var(--accent);
    color: #0a0a0b;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .nl-form button:hover:not(:disabled) {
    opacity: 0.9;
  }
  .nl-form button:disabled,
  .nl-form input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .nl-success {
    align-self: center;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nl-success[hidden] {
    display: block;
    visibility: hidden;
  }
  .nl-error {
    min-height: 1.4rem;
    margin-top: 0.5rem;
    color: #c04a35;
    font-size: 0.85rem;
  }
  .nl-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .nl-card {
      padding: 1.25rem;
    }
    .nl-form button {
      width: 100%;
    }
  }
</style>
